DATABASE_URL=postgresql://user:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
DEEPGRAM_API_KEY=your-deepgram-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET=your-jwt-secret

# Token de prueba sin base de datos (POST /auth/dev-token). Ponlo en false en producción.
ALLOW_DEV_LOGIN=true

# ─── Limpieza de audio en tiempo real (antes de transcribir) ───
ENABLE_AUDIO_CLEANING=true       # reducción de ruido ambiente + VAD
NOISE_REDUCTION_STRENGTH=0.85    # 0.0 (suave) .. 1.0 (agresivo)
ENABLE_VAD_GATE=true             # atenúa cuando solo hay ruido de fondo
ENABLE_HIGHPASS=true             # filtra retumbe de baja frecuencia

PORT=8000
